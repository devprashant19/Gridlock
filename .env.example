# ==============================================================================
# GRIDLOCK ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in the values for your workstream.
# Each workstream can also have its own scoped .env inside its subfolder.

# ------------------------------------------------------------------------------
# WORKSTREAM A: Contracts, Bots, Chainlink CRE
# ------------------------------------------------------------------------------
MONAD_RPC="https://testnet-rpc.monad.xyz"
MONAD_CHAIN_ID=10143
DEPLOYER_PK="0x..."
PROVIDER_PK="0x..."
BUYER_PK="0x..."
KURU_ROUTER="0x7EFbE105Ca7415dE98F96622173458ac1c054630"

# Chainlink CRE
CRE_CHAIN_SELECTOR="monad-testnet"
CRE_ORNN_API_URL="https://ornn.finance/api/gpu"

# ------------------------------------------------------------------------------
# WORKSTREAM B: Web App & Envio Indexer
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MONAD_RPC="https://testnet-rpc.monad.xyz"
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_ENVIO_GRAPHQL="https://indexer.bigdevenergy.link/0000000/v1/graphql"
NEXT_PUBLIC_VERIFIER_API_URL="http://localhost:8000"
# Once deployed: NEXT_PUBLIC_VERIFIER_API_URL="https://verifier.gridlock.network"

# ------------------------------------------------------------------------------
# WORKSTREAM C: Verifier, Skills & Submission
# ------------------------------------------------------------------------------
# Workstream 02 (Verifier)
VERIFIER_HOST="0.0.0.0"
VERIFIER_PORT=8000
VERIFIER_SIGNER_PK="0x..."
# Note: Provide the public address of VERIFIER_SIGNER_PK to Workstream A as VERIFIER_SIGNER_ADDRESS

# Workstream 06 (MetaMask Skill)
AGENT_RPC_URL="https://testnet-rpc.monad.xyz"
